{
  "name": "rhteaster",
  "version": "2.1.0",
  "description": "Rhteaster — Self-Hosted WhatsApp AI Agent, Web Ops Dashboard & VPS CLI Toolkit (Baileys + Antigravity CLI)",
  "main": "index.js",
  "bin": {
    "rhteaster": "./bin/rhteaster.js"
  },
  "scripts": {
    "start": "node index.js",
    "dashboard": "node dashboard/server.js",
    "pair": "node index.js --pair",
    "cli": "node bin/rhteaster.js",
    "status": "node bin/rhteaster.js status",
    "doctor": "node bin/rhteaster.js doctor",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rhteaster-ui/rhteaster.git"
  },
  "homepage": "https://github.com/rhteaster-ui/rhteaster#readme",
  "bugs": {
    "url": "https://github.com/rhteaster-ui/rhteaster/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "ai-agent",
    "antigravity",
    "gemini",
    "ops-dashboard",
    "task-map",
    "cli",
    "vps",
    "rhteaster"
  ],
  "author": "rhteaster-ui",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^5.1.0",
    "pino": "^10.4.0"
  }
}
